# Resume Screening Assistant Environment Configuration

# Flask Application
FLASK_APP=backend.app:create_app
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-12345
PORT=5000

# Database Configuration (SQLite default; use postgresql://user:pass@host/dbname for production)
DATABASE_URL=sqlite:///resume_screening.db

# Storage / Upload Directory
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size

# Optional AI API Key (Gemini or OpenAI) - Application functions deterministically if empty
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini  # 'gemini', 'openai', or 'none'
